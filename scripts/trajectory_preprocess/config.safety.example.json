{
  "version": "trajectory-preprocess-1",
  "providers": {
    "default": {
      "url": "https://api.deepseek.com/v1",
      "key": "${DEEPSEEK_API_KEY}",
      "model": "auto",
      "preferred_models": [
        "deepseek-flash"
      ],
      "timeout_seconds": 180,
      "trust_env": false,
      "extra_body_by_host": {
        "api.deepseek.com": {
          "thinking": {
            "type": "disabled"
          }
        }
      }
    },
    "local": {
      "url": "http://127.0.0.1:8000/v1",
      "key": "",
      "model": "auto",
      "timeout_seconds": 300,
      "trust_env": false,
      "max_concurrent_requests": 2
    }
  },
  "stages": {
    "inventory": {
      "provider": "default"
    },
    "audit": {
      "provider": "default"
    },
    "review": {
      "provider": "default"
    },
    "behaviors": {
      "provider": "default"
    },
    "rewrite": {
      "provider": "default"
    },
    "counterfactual": {
      "provider": "default"
    },
    "counterfactual_review": {
      "provider": "default"
    },
    "safety_review": {
      "provider": "default"
    },
    "safety_verify": {
      "provider": "local"
    }
  },
  "generation": {
    "temperature": 0,
    "max_tokens": 10000,
    "attempts": 2
  },
  "execution": {
    "workers": 2,
    "max_sample_chars": 250000
  },
  "dedup": {
    "near_question_hamming_distance": 3,
    "max_bucket_candidates": 200
  },
  "harness": {
    "search_name": "web_search",
    "extract_name": "web_extract",
    "extract_max_urls": 5
  },
  "inputs": []
}
